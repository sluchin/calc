# Doxyfile
#
# Doxygen 1.9 以降の設定. 標準と異なる項目だけを書く.
# 生成: make doc (CMake でも, GNU make でも同じ)
#   出力先や HAVE_DOT などは, make doc が, このファイルの後ろに追加して上書きする.

PROJECT_NAME           = "CALC"
OUTPUT_DIRECTORY       = ./docs
OUTPUT_LANGUAGE        = Japanese
INPUT_ENCODING         = UTF-8
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = YES

# 解析するファイル
INPUT                  = README.md \
                         MISRA.md \
                         lib \
                         calc \
                         server \
                         client \
                         tests
FILE_PATTERNS          = *.c \
                         *.h \
                         *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */third_party/*
USE_MDFILE_AS_MAINPAGE = README.md

# 条件付きコンパイルの部分 (テスト用の関数など) も, 解析する
ENABLE_PREPROCESSING   = YES
PREDEFINED             = UNITTEST \
                         HAVE_EXECINFO \
                         HAVE_READLINE \
                         _USE_SELECT \
                         "DEFINE_FFF_GLOBALS=" \
                         "FAKE_VALUE_FUNC(...)=" \
                         "FAKE_VOID_FUNC(...)=" \
                         "TEST_PASSTHROUGH(...)=" \
                         "GREATEST_MAIN_DEFS()=" \
                         "TEST=void" \
                         "LOG_FORMAT(a,b)="
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES

# static の関数も出力する (ドキュメントのないものは, 警告にする)
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TODOLIST      = YES

# 警告
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# 出力
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = NO

# グラフ (dot が無いときは, make doc が, HAVE_DOT = NO にする)
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = NO
INCLUDE_GRAPH          = YES
DIRECTORY_GRAPH        = YES
DOT_CLEANUP            = YES
